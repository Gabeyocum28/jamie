{
  "manifest_version": 3,
  "name": "Jamie",
  "version": "0.1",
  "description": "Send a Jamie into this Google Meet.",
  "action": { "default_popup": "popup.html", "default_title": "Jamie" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
