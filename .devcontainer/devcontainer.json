{
  "name": "jamie",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "runArgs": ["--init", "--shm-size=2g", "--env-file", "${localWorkspaceFolder}/.env"],
  "overrideCommand": false,
  "workspaceMount": "source=${localWorkspaceFolder}/workspace/default,target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder}/environments/default,target=/environment,type=bind,readonly",
    "source=${localWorkspaceFolder}/personalities,target=/personalities,type=bind,readonly"
  ],
  "forwardPorts": [6080, 3000, 5173, 8000]
}
