# Agent logins. Claude: run `claude setup-token` on your Mac and paste the token here.
# Codex / Gemini: run ./jamie.sh agent-login codex|gemini once, or set an API key below.
CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_API_KEY=
# GEMINI_API_KEY=

# Jamie's voice: ElevenLabs when a key is set, otherwise offline Piper.
# Connect your account with: npx -y @elevenlabs/cli@latest onboard connect --env-path .env
# Or put a key with Text to Speech access here. Never commit a real key.
ELEVENLABS_API_KEY=
# Rachel is the default; use a voice ID from your ElevenLabs voice library to change it.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# JAMIE_VOICE=off (or the extension's Voice toggle) keeps Jamie silent.
JAMIE_VOICE=on

# Name Jamie joins the call with (as a guest; you admit it)
JAMIE_NAME=Jamie
# Chat command. Change it to something obscure if non-trusted people are in your calls.
JAMIE_TRIGGER=/jamie
# full = Claude can run any command in the container. safe = web search + read files only.
JAMIE_PERMISSIONS=full
# Max seconds per request
JAMIE_TIMEOUT=900

# Which room, personality and agent CLI Jamie starts with (folders in environments/ and personalities/).
# Override per run: ./jamie.sh join <url> --env NAME --personality NAME --agent NAME
JAMIE_ENV=default
JAMIE_PERSONALITY=default
JAMIE_AGENT=claude

# Secret the Chrome extension sends to the controller. ./jamie.sh controller generates one if empty.
JAMIE_CONTROLLER_TOKEN=

# Only if Jamie's screen crashes on an Apple Silicon Mac: run it as Intel under emulation (noticeably slower).
# JAMIE_DOCKER_PLATFORM=linux/amd64
